# backend/.env.example
# 이 파일을 .env로 복사한 뒤 실제 발급받은 값으로 채워주세요.
# .env는 .gitignore에 이미 포함되어 있어 커밋되지 않습니다.
#
# 아무 값도 채우지 않으면 앱은 정상 동작하되, 캠페인 발송이 실제로 나가지 않고
# "simulated"(시뮬레이션) 상태로 처리됩니다.

# --- 카카오 알림톡 (알리고 https://smartsms.aligo.in) ---
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER_KEY=
ALIGO_SENDER_PHONE=
# SMS 발송에도 ALIGO_API_KEY / ALIGO_USER_ID / ALIGO_SENDER_PHONE을 함께 씁니다.
ALIGO_TEST_MODE=true

# --- 이메일 (SendGrid) ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=고객 리텐션팀

# --- 앱 푸시 (Firebase Cloud Messaging, Legacy 서버 키) ---
FCM_SERVER_KEY=

PORT=4000
